{
  "name": "Settlement",
  "type": "object",
  "properties": {
    "trip_id": {
      "type": "string"
    },
    "from_user_id": {
      "type": "string"
    },
    "from_name": {
      "type": "string"
    },
    "to_user_id": {
      "type": "string"
    },
    "to_name": {
      "type": "string"
    },
    "amount_minor": {
      "type": "number"
    },
    "currency": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "rejected",
        "cancelled"
      ],
      "default": "pending"
    },
    "note": {
      "type": "string"
    },
    "settled_on": {
      "type": "string",
      "format": "date"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User ids of everyone in the trip"
    }
  },
  "required": [
    "trip_id",
    "from_user_id",
    "to_user_id",
    "amount_minor"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.members": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.members": {
        "$in": [
          "{{user.id}}"
        ]
      }
    },
    "update": {
      "$or": [
        {
          "data.from_user_id": "{{user.id}}"
        },
        {
          "data.to_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}