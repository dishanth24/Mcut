{
  "name": "Trip",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "destination": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "currency": {
      "type": "string",
      "default": "INR"
    },
    "cover_image": {
      "type": "string"
    },
    "budget_minor": {
      "type": "number"
    },
    "archived": {
      "type": "boolean",
      "default": false
    },
    "members": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User ids of everyone in the trip"
    }
  },
  "required": [
    "name",
    "currency"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.members": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.members": {
        "$in": [
          "{{user.id}}"
        ]
      }
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}